<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Capital-Bridge Nudge: daily 08:05 CT. Emails David Mitchell a PO10 follow-up flag
     (with the MC finance link) when days-since-last-commitment >= threshold. Dedup built in. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.exos.capital-bridge-nudge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/exomac/.openclaw/workspace/scripts/capital_bridge_nudge.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/exomac/.openclaw/workspace</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/exomac/.openclaw/workspace/logs/capital-bridge-nudge.out.log</string>
  <key>StandardErrorPath</key><string>/Users/exomac/.openclaw/workspace/logs/capital-bridge-nudge.err.log</string>
</dict></plist>
